# ---- Dependencies -----------------------------------------------------------
# node_modules contains a dev-only symlink (@deepseek-ai -> the DSH profile's
# hoisted deps). Never commit it — clone with `pnpm install` instead.
node_modules/

# ---- macOS ------------------------------------------------------------------
.DS_Store
.DS_Store?*
._*
.Spotlight-V100
.Trashes

# ---- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editor / IDE -----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.zed/

# ---- Backup / temp files ----------------------------------------------------
*.bak
*.bak.*
*.orig
*.tmp
tmp/
temp/

# ---- Secrets ----------------------------------------------------------------
# Local environment and credential files must never be committed. GitHub push
# protection only recognizes provider-shaped tokens (sk-, ghp_, …), so this
# rule is the real guard for custom keys such as OLLAMA_API_KEY.
.env
.env.*
!.env.example
.credentials*
*.pem
*.p12
