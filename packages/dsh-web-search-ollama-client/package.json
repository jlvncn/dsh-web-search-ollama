{
  "name": "@jlvncn/dsh-web-search-ollama-client",
  "version": "0.1.13",
  "description": "Browser half for @jlvncn/dsh-web-search-ollama: registers the plugin row's configuration card on the DeepSeek Harness Web UI Plugins page",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlvncn/dsh-web-search-ollama.git"
  },
  "homepage": "https://github.com/jlvncn/dsh-web-search-ollama#readme",
  "bugs": {
    "url": "https://github.com/jlvncn/dsh-web-search-ollama/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "settings",
    "ollama"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
