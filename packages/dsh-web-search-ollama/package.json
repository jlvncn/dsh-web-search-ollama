{
  "name": "dsh-web-search-ollama",
  "version": "0.1.3",
  "description": "Ollama-backed search & fetch provider for the DeepSeek Harness `ctx.web` seam (host half of the web-search-ollama plugin)",
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "main": "index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlvncn/dsh-web-search-ollama.git"
  },
  "homepage": "https://github.com/jlvncn/dsh-web-search-ollama#readme",
  "bugs": {
    "url": "https://github.com/jlvncn/dsh-web-search-ollama/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "web-search",
    "ollama"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc --outDir . --esModuleInterop --target es2020 --module esnext --skipLibCheck",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@deepseek-ai/cordis": "^4.0.2"
  }
}